{
    "name": "chr-z/valida-nfse",
    "description": "Validador offline de XML de NFS-e (DPS/NFSe padrao nacional e ABRASF) para PHP. Zero dependencias de runtime, sem rede, com codigos de erro estaveis para CI.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nfse",
        "nfs-e",
        "dps",
        "validacao",
        "validator",
        "fiscal",
        "abrasf",
        "nota-fiscal"
    ],
    "authors": [
        {
            "name": "Christian Eliel",
            "email": "thezyonn@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-xml": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "ChrZ\\ValidaNfse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrZ\\ValidaNfse\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/valida-nfse"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
